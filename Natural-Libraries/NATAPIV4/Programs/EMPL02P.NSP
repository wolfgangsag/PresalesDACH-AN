* >Natural Source Header 000000
* :Mode S
* :CP ISO_8859-1:1987
* :LineIncrement 10
* <Natural Source Header
/** Program EMPL02P.
/** Find one employee by personnel-id in Adabas
/**
/** :author sagapg
/**
/* 
DEFINE DATA LOCAL
1 MESSAGE          (A) DYNAMIC   /* OUT
1 EMPLOYEE                       /* OUT
  2 PERSONNELID    (A8)
  2 FIRSTNAME      (A20)
  2 NAME           (A20)
  2 MAR-STAT       (A1)
  2 SEX            (A1)
  2 BIRTH          (D)
  2 ADDRESS
    3 COUNTRY      (A3)
    3 ZIP          (A10)
    3 CITY         (A20)
    3 ADDRESSLINE  (A20/*)
  2 TELEPHONE
    3 AREACODE     (A6)
    3 PHONE        (A15)
  2 DEPT           (A6)
  2 JOB-TITLE      (A25)
  2 LANG           (A3/*)
  2 CARS           (/1:*)
    3 REG-NUM      (A15)
    3 MAKE         (A20)
    3 MODEL        (A20)
    3 COLOR        (A10)
    3 YEAR         (N4.0)
END-DEFINE
*
CALLNAT 'EMPL02N' '99990001' MESSAGE EMPLOYEE
IF PERSONNELID <> ' '
    DISPLAY NOHDR    'Personnel ID    :' '=' PERSONNELID /
                     'Firstname       :' '=' FIRSTNAME /
                     'Name            :' '=' NAME /
                     'Gender          :' '=' SEX /
                     'Birthdate       :' '=' BIRTH /
                     'Zip             :' '=' ZIP /
                     'City            :' '=' CITY /
                     'Job Title       :' '=' JOB-TITLE /
                     'Message         :' '=' MESSAGE (AL=60)   
    IF *OCC(REG-NUM) > 0
      DISPLAY NOHDR    'Cars            :' '=' REG-NUM(*) (AL=60) /
    ELSE
      DISPLAY NOHDR    'Cars            :' 'NO CARS' /
    END-IF

    IF *OCC(REG-NUM) > 0
      DISPLAY NOHDR    'Addresslines    :' '=' ADDRESSLINE(*) (AL=60) /
    ELSE
      DISPLAY NOHDR    'Addresslines    :' 'No address lines' /
    END-IF
ELSE
    PRINT   'Message:' MESSAGE 
END-IF
*
WRITE 'done'
*
END
