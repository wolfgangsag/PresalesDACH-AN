DEFINE DATA LOCAL
1 LOGO (A) DYNAMIC
1 MSGTEXT (A) DYNAMIC
1 MSGTYPE (A) DYNAMIC
1 MYMENU (1:*)
2 LEVEL (I4)
2 OPENED (I4)
2 SELECTED (L)
2 TEXT (A) DYNAMIC
1 MYSEARCH (A) DYNAMIC
1 MYTITLE (A) DYNAMIC
1 SUBPAGE (A) DYNAMIC
1 USER (A) DYNAMIC
1 XCIEVENTDATA
2 XCIINDEX (I4)
LOCAL
1 I (I2) INIT <0>
1 PAGE (A) DYNAMIC
END-DEFINE
*
RESIZE ARRAY MYMENU  TO (1:4)
* **************************************
*  OPENED: 2 endnode; 0 node with subnodes
*  LEVEL: 1 or 2 - limited to 2 levels
* **************************************
*
/* **************************
/*
ADD 1 TO I
TEXT(I)  := 'Employees'
LEVEL(I)  := 1
OPENED(I) := 2
/*
* ADD 1 TO I
* TEXT(I)  := 'Submenu 1'
* LEVEL(I) := 2
* OPENED(I):= 2
/*
/* **************************
/*
ADD 1 TO I
TEXT(I)  := 'Vehicles'
LEVEL(I)  := 1
OPENED(I) := 2
/* **************************
/*
ADD 1 TO I
TEXT(I)  := 'Vehicles assignment'
LEVEL(I)  := 1
OPENED(I) := 2
/* **************************
/*
ADD 1 TO I
TEXT(I)  := 'Language (Idioma, Sprache)'
LEVEL(I)  := 1
OPENED(I) := 2

/* **************************

MYTITLE := 'Employees Maintenance'
LOGO := 'images/Logo-Natural_for_Ajax-On-darkFalseMonochromeFalse.svg'
PAGE := 'https://city311linux/cisnatural/servlet/StartCISPage?PAGEURL=/cisnatural/NatLogon.html&xciParameters.natsession=HR-Rail&xciParameters.natuser=sagtst'

*
PROCESS PAGE USING "MENU-A"
*
DECIDE ON FIRST *PAGE-EVENT
 VALUE U'nat:page.end', U'nat:browser.end'
  /* Page closed.
  IGNORE
 VALUE U'mymenu.onSelectMenuItem'
  DECIDE ON FIRST XCIINDEX
    VALUE 1
     COMPRESS PAGE '&xciParameters.natparam=stack=(logon HJC3270;NSWEMP1P;fin)' INTO SUBPAGE LEAVING NO
    VALUE 2
     COMPRESS PAGE '&xciParameters.natparam=stack=(logon HJC3270;NSWVEH1P;fin)' INTO SUBPAGE LEAVING NO
    VALUE 3
     COMPRESS PAGE '&xciParameters.natparam=stack=(logon HJC3270;NSWVEH2P;fin)' INTO SUBPAGE LEAVING NO
    VALUE 4
     COMPRESS PAGE '&xciParameters.natparam=stack=(logon HJC3270;NSWLANGP;fin)' INTO SUBPAGE LEAVING NO
    NONE VALUE
     COMPRESS 'You selected menu item <b>'TEXT(XCIINDEX)'</b>' INTO MSGTEXT LEAVING NO
     MSGTYPE:='S'
     COMPRESS 'Employees Maintenance - 'TEXT(XCIINDEX)' </b>' INTO MYTITLE
  END-DECIDE
  PROCESS PAGE UPDATE FULL
  /* FETCH RETURN 'NSWEMP1P'
 VALUE U'onHelp'
  COMPRESS 'You clicked the Help button' INTO MSGTEXT LEAVING NO
  MSGTYPE:='S'
  PROCESS PAGE UPDATE FULL
 VALUE U'onSearch'
  COMPRESS 'You clicked the Search button. Search value is <b>'MYSEARCH'</b>' INTO MSGTEXT LEAVING NO
  MSGTYPE:='S'
  PROCESS PAGE UPDATE FULL
 VALUE U'onLogin'
  COMPRESS 'You clicked the Login button. User is <b>'USER'</b>' INTO MSGTEXT LEAVING NO
  MSGTYPE:='S'
  PROCESS PAGE UPDATE FULL
 VALUE U'onExit'
  ESCAPE ROUTINE
  PROCESS PAGE UPDATE FULL
 VALUE U'onLogin'
  PROCESS PAGE UPDATE FULL
 VALUE U'onSearch'
  PROCESS PAGE UPDATE FULL
 NONE VALUE
  /* Unhandled events.
  PROCESS PAGE UPDATE
END-DECIDE
*
END
