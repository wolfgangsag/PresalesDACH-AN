* >Natural Source Header 000000
* :CP
* :LineIncrement 10
* <Natural Source Header
* PAGE1: PROTOTYPE /*<RO>>
* PROCESS PAGE USING 'XXXXXXXX' WITH
* LOGO MSGTEXT MSGTYPE MYMENU.LEVEL(*) MYMENU.OPENED(*)
* MYMENU.SELECTED(*) MYMENU.TEXT(*) MYSEARCH MYTITLE SUBPAGE USER
* XCIEVENTDATA.XCIINDEX
DEFINE DATA PARAMETER
/*( PARAMETER
1 LOGO (A) DYNAMIC
1 MSGTEXT (A) DYNAMIC
1 MSGTYPE (A) DYNAMIC
1 MYMENU (1:*)
2 LEVEL (I4)
2 OPENED (I4)
2 SELECTED (L)
2 TEXT (A) DYNAMIC
1 MYSEARCH (A) DYNAMIC
1 MYTITLE (A) DYNAMIC
1 SUBPAGE (A) DYNAMIC
1 USER (A) DYNAMIC
1 XCIEVENTDATA
2 XCIINDEX (I4)
/*) END-PARAMETER
END-DEFINE
*
/*( PROCESS PAGE
PROCESS PAGE U'/hjc3270/menu' WITH
PARAMETERS
 NAME U'logo'
  VALUE LOGO
 NAME U'msgtext'
  VALUE MSGTEXT
 NAME U'msgtype'
  VALUE MSGTYPE
 NAME U'mymenu(*).level'
  VALUE MYMENU.LEVEL(*)
 NAME U'mymenu(*).opened'
  VALUE MYMENU.OPENED(*)
 NAME U'mymenu(*).selected'
  VALUE MYMENU.SELECTED(*) (EM='false'/'true')
 NAME U'mymenu(*).text'
  VALUE MYMENU.TEXT(*)
 NAME U'mysearch'
  VALUE MYSEARCH
 NAME U'mytitle'
  VALUE MYTITLE
 NAME U'subpage'
  VALUE SUBPAGE
 NAME U'user'
  VALUE USER
 NAME U'xcieventdata.xciindex'
  VALUE XCIEVENTDATA.XCIINDEX
END-PARAMETERS
/*) END-PROCESS
*
/*/*( DEFINE EVENT HANDLER
* DECIDE ON FIRST *PAGE-EVENT
*  VALUE U'nat:page.end', U'nat:browser.end'
*   /* Page closed.
*   IGNORE
*  VALUE U'mymenu.onSelectMenuItem'
*   PROCESS PAGE UPDATE FULL
*  VALUE U'onExit'
*   PROCESS PAGE UPDATE FULL
*  VALUE U'onLogin'
*   PROCESS PAGE UPDATE FULL
*  VALUE U'onSearch'
*   PROCESS PAGE UPDATE FULL
*  NONE VALUE
*   /* Unhandled events.
*   PROCESS PAGE UPDATE
* END-DECIDE
/*/*) END-HANDLER
*
END /*<<RO>
