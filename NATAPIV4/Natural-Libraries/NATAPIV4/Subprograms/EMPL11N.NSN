* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Subprogram EMPL11N.
/** READ list of employees by last-name using MASK/EXAMINE
/** :author sagapg
/* TODO Enter your code here
DEFINE DATA PARAMETER
  1 LASTNAME         (A20)          /* in  oapi.n: LASTNAME    */
  1 MESSAGE          (A) DYNAMIC    /* out oapi.n: MESSAGE     */
  1 EMPLOYEES        (/1:*)         /* out oapi.n: EMPLOYEES   */
    2 PERSONNELID    (A8)
    2 FIRSTNAME      (A20)
    2 NAME           (A20)
    2 BIRTH          (D)
    2 MAR-STAT       (A1)
    2 SEX            (A1)
    2 CITY           (A20)
    2 ZIP            (A10)
    2 COUNTRY        (A3)
    2 DEPT           (A6)
    2 JOB-TITLE      (A25)
LOCAL
1 #CNT-E (I4)
1 LASTNAMEZZZ (A20)
1 EMPL VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 FIRST-NAME
  2 NAME
  2 BIRTH
  2 MAR-STAT
  2 SEX
  2 CITY
  2 ZIP
  2 POST-CODE
  2 COUNTRY
  2 DEPT
  2 JOB-TITLE
1 UDB (A3) INIT <' '>
1 #POS (I4)
END-DEFINE
*
ST. SETTIME
*
IF UDB <> ' '
    CALLNAT 'SETUDB-N' UDB
ELSE
    CALLNAT 'GETUDB-N' UDB
END-IF
*
READ1. READ EMPL BY NAME
    /* ACCEPT IF EMPL.NAME = MASK (*XXX*) LASTNAME    /* can't use variable length of LASTNAME
    EXAMINE EMPL.NAME FOR LASTNAME GIVING POSITION #POS
    IF #POS > 0
        ADD 1 TO #CNT-E
        EXPAND ARRAY EMPLOYEES TO (1:#CNT-E)
        EMPLOYEES.PERSONNELID(#CNT-E) := EMPL.PERSONNEL-ID
        EMPLOYEES.FIRSTNAME(#CNT-E)   := EMPL.FIRST-NAME
        EMPLOYEES.NAME(#CNT-E)        := EMPL.NAME
        EMPLOYEES.BIRTH(#CNT-E)       := EMPL.BIRTH
        EMPLOYEES.MAR-STAT(#CNT-E)    := EMPL.MAR-STAT
        EMPLOYEES.SEX(#CNT-E)         := EMPL.SEX
        EMPLOYEES.CITY(#CNT-E)        := EMPL.CITY
        EMPLOYEES.ZIP(#CNT-E)         := EMPL.ZIP
        EMPLOYEES.COUNTRY(#CNT-E)     := EMPL.COUNTRY
        EMPLOYEES.DEPT(#CNT-E)        := EMPL.DEPT
        EMPLOYEES.JOB-TITLE(#CNT-E)   := EMPL.JOB-TITLE
   END-IF
END-READ
*
COMPRESS #CNT-E ' EMPLOYEES FOUND. MASK: "*' LASTNAME '*", CODEPAGE: "' *CODEPAGE '", USER: "' *USER '", INIT-USER: "' *INIT-USER '", UDB: "' UDB '"'
    INTO MESSAGE LEAVING NO
*
COMPRESS MESSAGE 'ELAPSED (HH:MM:SS.T): ' *TIMD (ST.) (EM=99:99:99'.'99) TO MESSAGE
*
END
