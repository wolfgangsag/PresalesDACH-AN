* >Natural Source Header 000000
* :Mode S
* :CP ISO_8859-1:1987
* :LineIncrement 10
* <Natural Source Header
/** Program EMPL01N.
/** Find list of employees by last-name in Adabas
/**
/** :author sagapg
/** 
/* 
DEFINE DATA PARAMETER
1 LASTNAME         (A20)          /* IN    /* in  oapi.n: LASTNAME    */
1 MESSAGE          (A) DYNAMIC    /* OUT   /* out oapi.n: MESSAGE     */
1 EMPLOYEES        (/1:*)         /* OUT   /* out oapi.n: EMPLOYEES   */
    2 PERSONNELID    (A8)
    2 FIRSTNAME      (A20)
    2 NAME           (A20)
    2 BIRTH          (D)
    2 MAR-STAT       (A1)
    2 SEX            (A1)
    2 CITY           (A20)
    2 ZIP            (A10)
    2 COUNTRY        (A3)
    2 DEPT           (A6)
    2 JOB-TITLE      (A25)
  LOCAL
  1 #CNT-E (I4)
  1 LASTNAMEZZZ (A20)
  1 EMPL VIEW OF EMPLOYEES
    2 PERSONNEL-ID
    2 FIRST-NAME
    2 NAME
    2 BIRTH
    2 MAR-STAT
    2 SEX
    2 CITY
    2 ZIP
    2 POST-CODE
    2 COUNTRY
    2 DEPT
    2 JOB-TITLE
  1 UDB (A3) INIT <' '>
END-DEFINE
*
ST. SETTIME
* LIMIT 10
* *LANGUAGE := 1    /* 1: ENG, 2: GER, 3: FRE, 4: SPA 
*
IF UDB <> ' '
  CALLNAT 'SETUDB-N' UDB
ELSE
  CALLNAT 'GETUDB-N' UDB
END-IF
* 
* IF LASTNAME = " " OR LASTNAME = "0"THEN
*   COMPRESS 'PLEASE PROVIDE A LASTNAME (OR PART) TO SEARCH FOR.'INTO MESSAGE
*   ESCAPE ROUTINE
* ELSE
EXAMINE SUBSTRING(LASTNAME,1,1) TRANSLATE INTO UPPER
COMPRESS LASTNAME 'zzz' INTO LASTNAMEZZZ LEAVING NO
* END-IF
*
COUNT1. FIND NUMBER EMPL WITH NAME = LASTNAME THRU LASTNAMEZZZ
#CNT-E := *NUMBER(COUNT1.)
COMPRESS #CNT-E ' EMPLOYEES FOUND. FROM: "' LASTNAME '" TO: "' LASTNAMEZZZ 
'", CODEPAGE: "' *CODEPAGE '", USER: "' *USER '", INIT-USER: "' *INIT-USER '", UDB: "' UDB '"'
  INTO MESSAGE LEAVING NO

* Above LIMIT - investigate
* IF #CNT-E > 10
*     #CNT-E := 10
* END-IF

IF #CNT-E > 0 THEN
  EXPAND ARRAY EMPLOYEES TO (1:#CNT-E)
END-IF
*
FIND1. FIND EMPL WITH NAME = LASTNAME THRU LASTNAMEZZZ SORTED BY PERSONNEL-ID
  #CNT-E := *COUNTER(FIND1.)
  EMPLOYEES.PERSONNELID(#CNT-E) := EMPL.PERSONNEL-ID
  EMPLOYEES.FIRSTNAME(#CNT-E)   := EMPL.FIRST-NAME
  EMPLOYEES.NAME(#CNT-E)        := EMPL.NAME
  EMPLOYEES.BIRTH(#CNT-E)       := EMPL.BIRTH
  EMPLOYEES.MAR-STAT(#CNT-E)    := EMPL.MAR-STAT
  EMPLOYEES.SEX(#CNT-E)         := EMPL.SEX
  EMPLOYEES.CITY(#CNT-E)        := EMPL.CITY
  EMPLOYEES.ZIP(#CNT-E)         := EMPL.ZIP
  EMPLOYEES.COUNTRY(#CNT-E)     := EMPL.COUNTRY
  EMPLOYEES.DEPT(#CNT-E)        := EMPL.DEPT
  EMPLOYEES.JOB-TITLE(#CNT-E)   := EMPL.JOB-TITLE
END-FIND
*
* COMPRESS MESSAGE 'ELAPSED (HH:MM:SS.T): ' *TIMD (ST.) (EM=99:99:99'.'99) TO MESSAGE
*
END
