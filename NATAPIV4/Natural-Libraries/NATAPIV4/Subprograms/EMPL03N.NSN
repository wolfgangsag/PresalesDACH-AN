* >Natural Source Header 000000
* :Mode S
* :CP ISO_8859-1:1987
* :LineIncrement 10
* <Natural Source Header
/** Program EMPL03N.
/** Insert/Update (multiple) employees in Adabas
/**
/** :author sagapg
/**
/* 
DEFINE DATA PARAMETER
* 1 UDB              (A3)           /* in  oapi.n: UDB         */
1 EMPLOYEES (/1:*)                /* in  oapi.n: EMPLOYEES     */
  2 PERSONNELID    (A8)
  2 FIRSTNAME      (A20)
  2 NAME           (A20)
  2 MAR-STAT       (A1)
  2 SEX            (A1)
  2 BIRTH          (D)
  2 ADDRESS
    3 COUNTRY      (A3)
    3 ZIP          (A10)
    3 CITY         (A20)
    3 ADDRESSLINE  (A20/*)
  2 TELEPHONE
    3 AREACODE     (A6)
    3 PHONE        (A15)
  2 DEPT           (A6)
  2 JOB-TITLE      (A25)
  2 LANG           (A3/1:*)
  2 CARS (/1:*)
    3 REG-NUM      (A15)
    3 MAKE         (A20)
    3 MODEL        (A20)
    3 COLOR        (A10)
    3 YEAR         (N4.0)
1 MESSAGE          (A250)  /* out  oapi.n: MESSAGE       */ 
LOCAL
1 #CNT-E (I4)
1 #CNT-C (I4)
1 #CNT-L (I4)
1 #CNT-A (I4)
1 PERSON VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 FIRST-NAME
  2 NAME
  2 BIRTH
  2 MAR-STAT
  2 SEX
  2 DEPT
  2 JOB-TITLE
  2 LANG (1:5)
  2 FULL-ADDRESS
    3 ADDRESS-LINE (/1:5)
    3 CITY
    3 ZIP
    3 COUNTRY
  2 TELEPHONE
    3 AREA-CODE
    3 PHONE
1 CAR VIEW OF VEHICLES
  2 REG-NUM
  2 PERSONNEL-ID
  2 MAKE
  2 MODEL
  2 COLOR
  2 YEAR
1 #FOUND (L)   INIT <FALSE>
1 #CNT (I4)
1 #OCC (I4)    INIT <0>
1 #UPD-E (I4)  INIT <0>
1 #UPD-C (I4)  INIT <0>
1 #INS-E (I4)  INIT <0>
1 #INS-C (I4)  INIT <0>
1 #DEL-C (I4)  INIT <0>
1 #UPDATED (L) INIT <FALSE>
1 UDB (A3) INIT <' '>
END-DEFINE
*
ST. SETTIME
MESSAGE := 'DONE'
*
IF UDB <> ' '
    CALLNAT 'SETUDB-N' UDB
ELSE
    CALLNAT 'GETUDB-N' UDB
END-IF
*
FOR #CNT-E 1 TO *OCCURRENCE(EMPLOYEES.PERSONNELID)
  FIND PERSON WITH PERSON.PERSONNEL-ID = EMPLOYEES.PERSONNELID(#CNT-E)
    IF NO
      PERFORM MAPEMPLOYEE
      STORE PERSON
      ADD 1 TO #INS-E
      PERFORM FINDCAR
      END TRANSACTION
      ESCAPE BOTTOM
    END-NOREC
    PERFORM CHECKEMPLOYEE
    PERFORM MAPEMPLOYEE
    UPDATE
    PERFORM FINDCAR
    END TRANSACTION
  END-FIND
END-FOR
*
IF #INS-E <> 0 OR #UPD-E <> 0 THEN COMPRESS MESSAGE ' / EMPLOYEES: INSERTS=' #INS-E ', UPDATES=' #UPD-E ' (UDB:' UDB ')' TO MESSAGE LEAVING NO END-IF
IF #INS-C <> 0 OR #UPD-C <> 0 OR #DEL-C <> 0 THEN COMPRESS MESSAGE ' / CARS INSERTS=' #INS-C ', UPDATES=' #UPD-C ', DELETES=' #DEL-C ' (UDB:' UDB ')' TO MESSAGE LEAVING NO END-IF
IF MESSAGE = 'DONE' THEN
    COMPRESS 'NOTHING TO UPDATE' ' (UDB:' UDB ')' INTO MESSAGE LEAVING NO 
END-IF
*
* COMPRESS MESSAGE 'ELAPSED (HH:MM:SS.T): ' *TIMD (ST.) (EM=99:99:99'.'9) TO MESSAGE 
*
DEFINE SUBROUTINE CHECKEMPLOYEE
    #UPDATED := FALSE
    FOR #CNT-A 1 TO *OCC(EMPLOYEES.ADDRESSLINE,2)        /* upsert new ADDRESSLINEs
        IF PERSON.ADDRESS-LINE(#CNT-A) <> EMPLOYEES.ADDRESSLINE(#CNT-E, #CNT-A) 
            #UPDATED := TRUE
        END-IF
    END-FOR
    FOR #CNT-A #CNT-A TO *OCC(PERSON.ADDRESS-LINE)        /* delete old ADDRESSLINEs
        IF PERSON.ADDRESS-LINE(#CNT-A) <> ' ' 
            #UPDATED := TRUE
        END-IF
    END-FOR
*
    #OCC := 0
    FOR #CNT-L 1 TO *OCC(EMPLOYEES.LANG,2)        /* upsert new LANGs
        IF PERSON.LANG(#CNT-L) <> EMPLOYEES.LANG(#CNT-E, #CNT-L) 
            #UPDATED := TRUE
        END-IF
    END-FOR
    FOR #CNT-L #CNT-L TO *OCC(PERSON.LANG)        /* delete old LANGs
        IF PERSON.LANG(#CNT-L) <> ' ' 
            #UPDATED := TRUE
        END-IF
    END-FOR
*
    IF PERSON.PERSONNEL-ID  <> EMPLOYEES.PERSONNELID(#CNT-E) OR
       PERSON.FIRST-NAME    <> EMPLOYEES.FIRSTNAME(#CNT-E) OR
       PERSON.NAME          <> EMPLOYEES.NAME(#CNT-E) OR
       PERSON.MAR-STAT      <> EMPLOYEES.MAR-STAT(#CNT-E) OR
       PERSON.SEX           <> EMPLOYEES.SEX(#CNT-E) OR
       PERSON.BIRTH         <> EMPLOYEES.BIRTH(#CNT-E) OR
       PERSON.COUNTRY       <> EMPLOYEES.COUNTRY(#CNT-E) OR
       PERSON.ZIP           <> EMPLOYEES.ZIP(#CNT-E) OR
       PERSON.CITY          <> EMPLOYEES.CITY(#CNT-E) OR
       PERSON.AREA-CODE     <> EMPLOYEES.AREACODE(#CNT-E) OR
       PERSON.PHONE         <> EMPLOYEES.PHONE(#CNT-E) OR
       PERSON.DEPT          <> EMPLOYEES.DEPT(#CNT-E) OR
       PERSON.JOB-TITLE     <> EMPLOYEES.JOB-TITLE(#CNT-E) OR
       #UPDATED = TRUE
    THEN 
        ADD 1 TO #UPD-E 
    END-IF
END-SUBROUTINE
*
DEFINE SUBROUTINE MAPEMPLOYEE
    PERSON.PERSONNEL-ID  := EMPLOYEES.PERSONNELID(#CNT-E)
    PERSON.FIRST-NAME    := EMPLOYEES.FIRSTNAME(#CNT-E)
    PERSON.NAME          := EMPLOYEES.NAME(#CNT-E)
    PERSON.MAR-STAT      := EMPLOYEES.MAR-STAT(#CNT-E)
    PERSON.SEX           := EMPLOYEES.SEX(#CNT-E)
    PERSON.BIRTH         := EMPLOYEES.BIRTH(#CNT-E)
    PERSON.COUNTRY       := EMPLOYEES.COUNTRY(#CNT-E)
    PERSON.ZIP           := EMPLOYEES.ZIP(#CNT-E)
    PERSON.CITY          := EMPLOYEES.CITY(#CNT-E)
    PERSON.AREA-CODE     := EMPLOYEES.AREACODE(#CNT-E)
    PERSON.PHONE         := EMPLOYEES.PHONE(#CNT-E)
    PERSON.DEPT          := EMPLOYEES.DEPT(#CNT-E)
    PERSON.JOB-TITLE     := EMPLOYEES.JOB-TITLE(#CNT-E)
    /* EXAMINE PERSON.NAME TRANSLATE INTO UPPER
    #OCC := 0
    FOR #CNT-A 1 TO *OCC(EMPLOYEES.ADDRESSLINE,2)        /* upsert new ADDRESSLINEs
        IF PERSON.ADDRESS-LINE(#CNT-A) <> EMPLOYEES.ADDRESSLINE(#CNT-E, #CNT-A) 
            ADD 1 TO #OCC
            PERSON.ADDRESS-LINE(#CNT-A) := EMPLOYEES.ADDRESSLINE(#CNT-E, #CNT-A)
        END-IF
    END-FOR
    FOR #CNT-A #CNT-A TO *OCC(PERSON.ADDRESS-LINE)        /* delete old ADDRESSLINEs
        IF PERSON.ADDRESS-LINE(#CNT-A) <> ' ' 
            ADD 1 TO #OCC 
            PERSON.ADDRESS-LINE(#CNT-A) := ' '
        END-IF
    END-FOR
*
    #OCC := 0
    FOR #CNT-L 1 TO *OCC(EMPLOYEES.LANG,2)        /* upsert new LANGs
        IF PERSON.LANG(#CNT-L) <> EMPLOYEES.LANG(#CNT-E, #CNT-L) 
            ADD 1 TO #OCC
            PERSON.LANG(#CNT-L) := EMPLOYEES.LANG(#CNT-E, #CNT-L)
        END-IF
    END-FOR
    FOR #CNT-L #CNT-L TO *OCC(PERSON.LANG)        /* delete old LANGs
        IF PERSON.LANG(#CNT-L) <> ' ' 
            ADD 1 TO #OCC 
            PERSON.LANG(#CNT-L) := ' '
        END-IF
    END-FOR
*
    
END-SUBROUTINE
*
DEFINE SUBROUTINE CHECKCAR
    IF CAR.PERSONNEL-ID <> EMPLOYEES.PERSONNELID(#CNT-E) OR
       CAR.REG-NUM      <> EMPLOYEES.REG-NUM(#CNT-E,#CNT-C) OR
       CAR.MAKE         <> EMPLOYEES.MAKE(#CNT-E,#CNT-C) OR
       CAR.MODEL        <> EMPLOYEES.MODEL(#CNT-E,#CNT-C) OR
       CAR.COLOR        <> EMPLOYEES.COLOR(#CNT-E,#CNT-C) OR
       CAR.YEAR         <> EMPLOYEES.YEAR(#CNT-E,#CNT-C)
    THEN   
        ADD 1 TO #UPD-C
    END-IF
END-SUBROUTINE
*
DEFINE SUBROUTINE MAPCAR
    CAR.PERSONNEL-ID     := EMPLOYEES.PERSONNELID(#CNT-E)
    CAR.REG-NUM          := EMPLOYEES.REG-NUM(#CNT-E,#CNT-C)
    CAR.MAKE             := EMPLOYEES.MAKE(#CNT-E,#CNT-C)
    CAR.MODEL            := EMPLOYEES.MODEL(#CNT-E,#CNT-C)
    CAR.COLOR            := EMPLOYEES.COLOR(#CNT-E,#CNT-C)
    CAR.YEAR             := EMPLOYEES.YEAR(#CNT-E,#CNT-C)
END-SUBROUTINE
*
DEFINE SUBROUTINE FINDCAR
    FOR #CNT-C 1 TO *OCCURRENCE(EMPLOYEES.REG-NUM,2)
      IF EMPLOYEES.REG-NUM (#CNT-E,#CNT-C) NOT EQUAL " "
          FIND CAR WITH CAR.PERSONNEL-ID = EMPLOYEES.PERSONNELID(#CNT-E) AND CAR.REG-NUM = EMPLOYEES.REG-NUM (#CNT-E,#CNT-C)
            IF NO
              PERFORM MAPCAR
              STORE CAR
              ADD 1 TO #INS-C
              ESCAPE BOTTOM
            END-NOREC
            PERFORM CHECKCAR
            PERFORM MAPCAR
            UPDATE
          END-FIND
       END-IF
    END-FOR
    /* find cars to delete (workaround for another application creating empty cars)
    FIND CAR WITH CAR.PERSONNEL-ID = EMPLOYEES.PERSONNELID(#CNT-E)
        #FOUND := FALSE
        FOR #CNT-C 1 TO *OCCURRENCE(EMPLOYEES.REG-NUM,2)
            IF CAR.REG-NUM = EMPLOYEES.REG-NUM (#CNT-E,#CNT-C)
                #FOUND := TRUE
            END-IF    
        END-FOR
        IF #FOUND = FALSE
            ADD 1 TO #DEL-C
            DELETE
        END-IF
    END-FIND
END-SUBROUTINE
*
END
