* >Natural Source Header 000000
* :Mode S
* :CP windows-1252
* :LineIncrement 10
* <Natural Source Header
/************************************************************
/* Program.: PJOB
/* Funktion: Statistik - Anzahl der Mitarbeiter je Geschlecht (SEX)
/*           Aufruf Sub.PGM in dem via Histogramm die Daten 
/*           ermittelt werden
/* Autor...: A.Certa (10.2026)
/* Remarks.: P.Grünböck (11.2026)
/*           requires additional Descriptor on AG (Sex)
/*           >> adainv db=15 invert=11, fields AG
/************************************************************
/*
DEFINE DATA LOCAL
1 #OUT                 (1:*)   /** :out
  2 #OUT-SEX     (A1)    /** :out
  2 #OUT-COUNT         (N8)   /** :out
  2 #OUT-GESCHLECHT    (A20)
1 #INDEX (N8) INIT <0>
END-DEFINE
FORMAT LS=132
   
CALLNAT 'SSEX'
   #OUT-SEX (*)    
   #OUT-COUNT (*)
   #OUT-GESCHLECHT(*)
   #INDEX   
 EXPAND ARRAY #OUT TO (1:#INDEX) 
/*  
  DISPLAY  
  #OUT-SEX(1:#INDEX) 
  #OUT-GESCHLECHT(1:#INDEX)
  #OUT-COUNT (1:#INDEX)
/*  
END
