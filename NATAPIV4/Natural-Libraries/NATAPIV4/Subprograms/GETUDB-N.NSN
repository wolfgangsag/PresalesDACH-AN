* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Subprogram GETUDB-N.
/**
/** :author sagapg
/* TODO Enter your code here
DEFINE DATA 
PARAMETER
01 UDB (A3)    /* OUT
LOCAL
01 DATA (A253/4)             /* 'Bytecontainer' to get all data
01 REDEFINE DATA
   02 LOWER-UPPER (A1)       /* 'L' = lower-case, 'U' = upper-case
   02 RECAT       (A1)       /* 'X' = RECAT=ON , ' ' = RECAT=OFF
   02 DBUPD       (A1)       /* 'X' = DBUPD=ON , ' ' = DBUPD=OFF
   02 DELETE-PGM  (A1)       /* 'X' = DELETE=ON , ' ' = DELETE=OFF
   02 RELEASE-ISN (A1)       /* 'X' = RI=ON , ' ' = RI=OFF
   02 NATURAL-COMMANDS (A1)  /* 'X' = NC=ON , ' ' = NC=OFF
   02 STRUCTURED-MODE (A1)   /* 'X' = SM=ON , ' ' = SM=OFF
   02 CPU-TIME-LIMIT  (N8)   /* Value of parameter MT (dec.)
   02 MAXCL       (N5)       /* Value of parameter MAXCL (dec.)
   02 MADIO       (N5)       /* Value of parameter MADIO (dec.)
   02 AUTO        (A1)       /* 'X' = AUTO=ON , ' ' = AUTO=OFF
   02 DYNPARM     (A1)       /* 'X' = DYNPARM=ON , ' ' = DYNPARM=OFF
   02 TIME-DIFF   (A6)       /* Time differential
   02 DTFORM      (A1)       /* Date format
   02 ERROR-TA    (A8)       /* Name of current error transaction
   02 STEPLIB     (A8)       /* Name of current steplib
   02 LANG-CODE   (I1)       /* Current language code
   02 UDB1        (P3)       /* User DBID
   02 UPDATE-CMD  (A1)       /* 'X' = UPDATE=ON , ' ' = UPDATE=OFF
   02 DAY-DIFF    (N5)       /* Value of parameter DD (dec.)
   02 MESSAGE-LINE(A3)       /* Position of the message line
   02 PFKEY-LINE  (A3)       /* Position of the first PF-key line
   02 STAT-LINE   (A3)       /* Position of the statistics line
   02 IA          (A1)       /* Value of IA - Input assign character
   02 ID          (A1)       /* Value of ID - Input delimiter
   02 DC          (A1)       /* Value of DC - Decimal character
   02 CF          (A1)       /* Value of CF - Char. for terminal cmds;
                             /* For CF=OFF, the char. 'F' is returned
   02 UDB2        (N5)       /* User DBID (2 Byte long)
END-DEFINE
*
CALLNAT 'USR1005N' DATA (*)
UDB := UDB2
*
END
