* >Natural Source Header 000000
* :Mode S
* :CP ISO_8859-1:1987
* :LineIncrement 10
* <Natural Source Header
/** Program EMPL02N.
/** Find one employee by personnel-id in Adabas
/**
/** :author sagapg
/**
/* 
DEFINE DATA
PARAMETER
1 PERSNUMBER       (A8)          /* in   oapi.n: PERSNUMBER    */
1 MESSAGE          (A) DYNAMIC   /* out  oapi.n: MESSAGE       */
1 EMPLOYEE                       /* out  oapi.n: EMPLOYEE      */
  2 PERSONNELID    (A8)
  2 FIRSTNAME      (A20)
  2 NAME           (A20)
  2 MAR-STAT       (A1)
  2 SEX            (A1)
  2 BIRTH          (D)
  2 ADDRESS
    3 COUNTRY      (A3)
    3 ZIP          (A10)
    3 CITY         (A20)
    3 ADDRESSLINE  (A20/*)
  2 TELEPHONE
    3 AREACODE     (A6)
    3 PHONE        (A15)
  2 DEPT           (A6)
  2 JOB-TITLE      (A25)
  2 LANG           (A3/*)
  2 CARS           (/1:*)
    3 REG-NUM      (A15)
    3 MAKE         (A20)
    3 MODEL        (A20)
    3 COLOR        (A10)
    3 YEAR         (N4.0)
LOCAL
1 #CNT  (I2)    INIT <0>
1 PERSON VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 FIRST-NAME
  2 NAME
  2 MAR-STAT
  2 SEX
  2 BIRTH
  2 ADDRESS-LINE (1:5)
  2 CITY
  2 ZIP
  2 COUNTRY
  2 AREA-CODE
  2 PHONE
  2 DEPT
  2 JOB-TITLE
  2 LANG (1:5)
1 CAR VIEW OF VEHICLES
  2 REG-NUM
  2 PERSONNEL-ID
  2 MAKE
  2 MODEL
  2 COLOR
  2 YEAR
1 #OCC (I4)
1 UDB (A3) INIT <' '>
END-DEFINE
*
IF UDB <> ' '
    CALLNAT 'SETUDB-N' UDB
ELSE
    CALLNAT 'GETUDB-N' UDB
END-IF
*
IF PERSNUMBER = " " OR PERSNUMBER = "0" THEN
  PERSNUMBER := "99990000"
END-IF
*
FIND1. FIND PERSON WITH PERSONNEL-ID = PERSNUMBER
  IF NO RECORDS FOUND
    COMPRESS 'SPECIFIED NUMBER DOES NOT EXIST; CHOOSE ANOTHER ONE.' ' (UDB:' UDB ')' INTO MESSAGE LEAVING NO
    ESCAPE BOTTOM
  END-NOREC
  COMPRESS MESSAGE 'FOUND:' *COUNTER ' EMPLOYEE WITH PERSNUMBER:' PERSON.PERSONNEL-ID ' (UDB:' UDB ')' INTO MESSAGE LEAVING NO
  EMPLOYEE.PERSONNELID      := PERSON.PERSONNEL-ID
  EMPLOYEE.FIRSTNAME        := PERSON.FIRST-NAME
  EMPLOYEE.NAME             := PERSON.NAME
  EMPLOYEE.MAR-STAT         := PERSON.MAR-STAT
  EMPLOYEE.SEX              := PERSON.SEX
  EMPLOYEE.BIRTH            := PERSON.BIRTH
  #OCC := 0
  FOR #CNT 1 TO *OCC(PERSON.ADDRESS-LINE)
      IF PERSON.ADDRESS-LINE(#CNT) <> ' '
          ADD 1 TO #OCC 
          EXPAND ARRAY EMPLOYEE.ADDRESSLINE TO (1:#OCC)
          EMPLOYEE.ADDRESSLINE(#OCC)   := PERSON.ADDRESS-LINE(#CNT)
      END-IF
  END-FOR
  EMPLOYEE.CITY             := PERSON.CITY
  EMPLOYEE.ZIP              := PERSON.ZIP
  EMPLOYEE.COUNTRY          := PERSON.COUNTRY
  EMPLOYEE.AREACODE         := PERSON.AREA-CODE
  EMPLOYEE.PHONE            := PERSON.PHONE
  EMPLOYEE.DEPT             := PERSON.DEPT
  EMPLOYEE.JOB-TITLE        := PERSON.JOB-TITLE
  #OCC := 0
  FOR #CNT 1 TO *OCC(PERSON.LANG)
      IF PERSON.LANG(#CNT) <> ' '
          ADD 1 TO #OCC 
          EXPAND ARRAY EMPLOYEE.LANG TO (1:#OCC)
          EMPLOYEE.LANG(#OCC)   := PERSON.LANG(#CNT)
      END-IF
  END-FOR
  FIND2. FIND CAR WITH PERSONNEL-ID = PERSNUMBER
    IF NO RECORDS FOUND
      COMPRESS MESSAGE '; PERSON DOES NOT OWN ANY CARS' TO MESSAGE
      REDUCE ARRAY CARS TO (*)
      ESCAPE BOTTOM
    END-NOREC
    #CNT := *COUNTER
    RESIZE ARRAY CARS TO (1:#CNT) 
    EMPLOYEE.REG-NUM(#CNT) := CAR.REG-NUM
    EMPLOYEE.MAKE(#CNT)    := CAR.MAKE
    EMPLOYEE.MODEL(#CNT)   := CAR.MODEL
    EMPLOYEE.COLOR(#CNT)   := CAR.COLOR
    EMPLOYEE.YEAR(#CNT)    := CAR.YEAR
  END-FIND
END-FIND
*
END
