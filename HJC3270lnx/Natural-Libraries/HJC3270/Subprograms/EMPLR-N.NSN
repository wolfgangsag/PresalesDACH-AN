* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
/** Program EMPL02N.
/** Find one employee by personnel-id in Adabas
/**
/** :author sagapg
/**
/*
DEFINE DATA
PARAMETER
1 PERSNUMBER (A8)    /* IN
1 EMPLOYEE           /* OUT
  2 PERSONNELID    (A8)
  2 FIRSTNAME      (A20)
  2 NAME           (A20)
  2 MAR-STAT       (A1)
  2 SEX            (A1)
  2 BIRTH          (D)
  2 ADDRESS
    3 COUNTRY      (A3)
    3 ZIP          (A10)
    3 CITY         (A20)
    3 ADDRESSLINE  (A20/5)
  2 TELEPHONE
    3 AREACODE     (A6)
    3 PHONE        (A15)
  2 DEPT           (A6)
  2 JOB-TITLE      (A25)
  2 LANG           (A3/5)
  2 PHONETICNAME   (A20)
  2 CARS           (/1:*)
    3 REG-NUM      (A15)
    3 MAKE         (A20)
    3 MODEL        (A20)
    3 COLOR        (A10)
    3 YEAR         (N4.0)
  2 MESSAGE        (A250)
LOCAL
1 #CNT  (I2)    INIT <0>
1 PERSON VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 FIRST-NAME
  2 NAME
  2 MAR-STAT
  2 SEX
  2 BIRTH
  2 ADDRESS-LINE (1:5)
  2 CITY
  2 ZIP
  2 COUNTRY
  2 AREA-CODE
  2 PHONE
  2 DEPT
  2 JOB-TITLE
  2 LANG (1)
1 CAR VIEW OF VEHICLES
  2 REG-NUM
  2 PERSONNEL-ID
  2 MAKE
  2 MODEL
  2 COLOR
  2 YEAR
END-DEFINE
*
IF PERSNUMBER = " " OR PERSNUMBER = "0" THEN
  PERSNUMBER := "99990000"
END-IF
*
FIND1. FIND PERSON WITH PERSONNEL-ID = PERSNUMBER
  IF NO RECORDS FOUND
    MESSAGE := 'SPECIFIED NUMBER DOES NOT EXIST; CHOOSE ANOTHER ONE.'
    ESCAPE BOTTOM
  END-NOREC
  EMPLOYEE.PERSONNELID      := PERSON.PERSONNEL-ID
  EMPLOYEE.FIRSTNAME        := PERSON.FIRST-NAME
  EMPLOYEE.NAME             := PERSON.NAME
  EMPLOYEE.MAR-STAT         := PERSON.MAR-STAT
  EMPLOYEE.SEX              := PERSON.SEX
  EMPLOYEE.BIRTH            := PERSON.BIRTH
  EMPLOYEE.ADDRESSLINE(*)   := PERSON.ADDRESS-LINE(1:5)
  EMPLOYEE.CITY             := PERSON.CITY
  EMPLOYEE.ZIP              := PERSON.ZIP
  EMPLOYEE.COUNTRY          := PERSON.COUNTRY
  EMPLOYEE.AREACODE         := PERSON.AREA-CODE
  EMPLOYEE.PHONE            := PERSON.PHONE
  EMPLOYEE.DEPT             := PERSON.DEPT
  EMPLOYEE.JOB-TITLE        := PERSON.JOB-TITLE
  EMPLOYEE.LANG(*)          := PERSON.LANG(*)
  FIND2. FIND CAR WITH PERSONNEL-ID = PERSNUMBER
    IF NO RECORDS FOUND
      MESSAGE := 'PERSON DOES NOT OWN ANY CARS'
      RESIZE ARRAY CARS TO (1:1)
      ESCAPE BOTTOM
    END-NOREC
    #CNT := *COUNTER
    RESIZE ARRAY CARS TO (1:#CNT)
    EMPLOYEE.REG-NUM(#CNT) := CAR.REG-NUM
    EMPLOYEE.MAKE(#CNT)    := CAR.MAKE
    EMPLOYEE.MODEL(#CNT)   := CAR.MODEL
    EMPLOYEE.COLOR(#CNT)   := CAR.COLOR
    EMPLOYEE.YEAR(#CNT)   := CAR.YEAR
  END-FIND
END-FIND
*
END
