DEFINE DATA LOCAL

1 ID (A8) /* :in out
*  
1 EMPLOYEES (1:20) 
  2 PERSONNEL-ID (A8)
  2 FULL-NAME
    3 FIRST-NAME (A20)
    3 NAME (A20)
  2 MAR-STAT (A1)
  2 SEX (A1)
  2 FULL-ADDRESS
    3 ADDRESS-LINE (A20/1:1)
    3 CITY (A20)
    3 ZIP (A10)
    3 POST-CODE (A10)
    3 COUNTRY (A3)
  2 TELEPHONE
    3 AREA-CODE (A6)
    3 PHONE (A15)
  2 DEPT (A6)
  2 N@BIRTH (I2)
  2 BIRTH (D)
*
LOCAL
/*( imported data fields from Data Definition Module EMPLOYEES
1 EMPLOYEES-VIEW VIEW OF EMPLOYEES
  2 PERSONNEL-ID (A8)
  2 FULL-NAME
    3 FIRST-NAME (A20)
    3 NAME (A20)
  2 MAR-STAT (A1)
  2 SEX (A1)
  2 FULL-ADDRESS
    3 ADDRESS-LINE (A20/1:1)
    3 CITY (A20)
    3 ZIP (A10)
    3 POST-CODE (A10)
    3 COUNTRY (A3)
  2 TELEPHONE
    3 AREA-CODE (A6)
    3 PHONE (A15)
  2 DEPT (A6)
  2 JOB-TITLE (A25)
  2 BIRTH (D)
  2 N@BIRTH (I2)

1 #COUNTER (I4)

END-DEFINE
READ (20) EMPLOYEES-VIEW LOGICAL BY PERSONNEL-ID  
  DISPLAY
  EMPLOYEES-VIEW.NAME
  EMPLOYEES-VIEW.BIRTH
  EMPLOYEES-VIEW.N@BIRTH
  END-READ

END

