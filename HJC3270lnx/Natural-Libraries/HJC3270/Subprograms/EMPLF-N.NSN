* >Natural Source Header 000000
* :Mode S
* :CP
* :LineIncrement 10
* <Natural Source Header
/** Program EMPL01N.
/** Find list of employees by last-name in Adabas
/**
/** :author sagapg
/**
/*
DEFINE DATA PARAMETER
  1 LASTNAME      (A20)      /* IN * /
  1 MESSAGE (A) DYNAMIC      /* OUT */
  1 EMPLOYEES (/1:*)         /* OUT
    2 PERSONNELID    (A8)
    2 FIRSTNAME      (A20)
    2 NAME           (A20)
    2 BIRTH          (D)
    2 MAR-STAT       (A1)
    2 SEX            (A1)
    2 CITY           (A20)
    2 ZIP            (A10)
    2 COUNTRY        (A3)
    2 DEPT           (A6)
    2 JOB-TITLE      (A25)
    2 CARS           (/1:*)
      3 REG-NUM      (A15)
      3 MAKE         (A20)
      3 MODEL        (A20)
      3 COLOR        (A10)
      3 YEAR         (N4.0)
LOCAL
1 #CNT-E (I4)
1 #CNT-C (I4)
1 LASTNAMEZZZ (A20)
1 EMPL VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 FIRST-NAME
  2 NAME
  2 BIRTH
  2 MAR-STAT
  2 SEX
  2 CITY
  2 ZIP
  2 POST-CODE
  2 COUNTRY
  2 DEPT
  2 JOB-TITLE
1 CAR VIEW OF VEHICLES
  2 REG-NUM
  2 PERSONNEL-ID
  2 MAKE
  2 MODEL
  2 COLOR
  2 YEAR
1 #UDB (A3)
END-DEFINE
*
CALLNAT 'GETUDB-N' #UDB
*
IF LASTNAME = " " OR LASTNAME = "0"THEN
  COMPRESS 'PLEASE PROVIDE A LASTNAME (OR PART) TO SEARCH FOR.'INTO MESSAGE
  ESCAPE ROUTINE
ELSE
  EXAMINE LASTNAME TRANSLATE INTO UPPER
  COMPRESS LASTNAME 'ZZZ' INTO LASTNAMEZZZ LEAVING NO
END-IF
*
COUNT1. FIND NUMBER EMPL WITH NAME = LASTNAME THRU LASTNAMEZZZ
#CNT-E := *NUMBER(COUNT1.)
COMPRESS #CNT-E 'EMPLOYEES FOUND. FROM:' LASTNAME 'TO:' LASTNAMEZZZ
    '[' 'CODEPAGE:' *CODEPAGE ', USER:' *USER ', INIT-USER:' *INIT-USER ', UDB:' #UDB ']'
    INTO MESSAGE
IF #CNT-E > 0 THEN
  EXPAND ARRAY EMPLOYEES TO (1:#CNT-E)
END-IF
*
FIND1. FIND EMPL WITH NAME = LASTNAME THRU LASTNAMEZZZ
    #CNT-E := *COUNTER(FIND1.)
    EMPLOYEES.PERSONNELID(#CNT-E) := EMPL.PERSONNEL-ID
    EMPLOYEES.FIRSTNAME(#CNT-E)   := EMPL.FIRST-NAME
    EMPLOYEES.NAME(#CNT-E)        := EMPL.NAME
    EMPLOYEES.BIRTH(#CNT-E)       := EMPL.BIRTH
    EMPLOYEES.MAR-STAT(#CNT-E)    := EMPL.MAR-STAT
    EMPLOYEES.SEX(#CNT-E)         := EMPL.SEX
    EMPLOYEES.CITY(#CNT-E)        := EMPL.CITY
    EMPLOYEES.ZIP(#CNT-E)         := EMPL.ZIP
    EMPLOYEES.COUNTRY(#CNT-E)     := EMPL.COUNTRY
    EMPLOYEES.DEPT(#CNT-E)        := EMPL.DEPT
    EMPLOYEES.JOB-TITLE(#CNT-E)   := EMPL.JOB-TITLE
    FIND2. FIND CAR WITH PERSONNEL-ID = EMPL.PERSONNEL-ID
      IF NO RECORDS FOUND
        ESCAPE BOTTOM
      END-NOREC
      #CNT-C := *COUNTER(FIND2.)
      /* COMPRESS MESSAGE 'CARS:' *NUMBER(FIND2.) 'CAR:' #CNT-C INTO MESSAGE
      EXPAND ARRAY EMPLOYEES.CARS TO (*, 1:#CNT-C)
      EMPLOYEES.REG-NUM(#CNT-E, #CNT-C) := CAR.REG-NUM
      EMPLOYEES.MAKE(#CNT-E, #CNT-C)    := CAR.MAKE
      EMPLOYEES.MODEL(#CNT-E, #CNT-C)   := CAR.MODEL
      EMPLOYEES.COLOR(#CNT-E, #CNT-C)   := CAR.COLOR
      EMPLOYEES.YEAR(#CNT-E, #CNT-C)    := CAR.YEAR
    END-FIND
END-FIND
*
END
